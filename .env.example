# Celesto Sandbox Provider Configuration
# Supported providers: "cloud" (recommended for Windows/remote) or "local" (Linux with KVM/QEMU)
CELESTO_PROVIDER=cloud
# Celesto API Key obtained from https://celesto.ai
CELESTO_API_KEY=celesto_api_key_placeholder
# Backend architecture: "firecracker" or "qemu"
CELESTO_BACKEND=firecracker

# LLM Configuration (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=llm_api_key_placeholder
LLM_MODEL=gpt-4o-mini

# PostgreSQL Run Ledger Database URL
DATABASE_URL=postgresql://celesto:celestopass@ledger:5432/celesto_ledger

# API Service Configuration
API_PORT=8080
APP_ENV=development
